{
  "name": "crash-velocity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 9002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src packages scripts test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/physics && tsc --noEmit -p packages/net && tsc --noEmit -p packages/race && tsc --noEmit -p packages/battle && tsc --noEmit -p packages/data && tsc --noEmit -p packages/server && tsc --noEmit -p packages/core && tsc --noEmit -p packages/state && tsc --noEmit -p packages/engine && tsc --noEmit -p packages/game && tsc --noEmit -p packages/ui",
    "test": "vitest run",
    "test:physics": "bun scripts/vehicle-physics.ts",
    "dev:cli": "node scripts/dev-cli.mjs",
    "dev:probe": "node scripts/dev-cli.mjs probe",
    "dev:shot": "node scripts/dev-cli.mjs shot",
    "dev:console": "node scripts/dev-cli.mjs console",
    "dev:eval": "node scripts/dev-cli.mjs eval",
    "dev:server": "bun --watch packages/server/src/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:scenario": "bun packages/race/src/dev/replay-cli.ts",
    "dev:replay": "bun packages/battle/src/dev/replay-cli.ts",
    "db:generate": "drizzle-kit generate --config packages/data/drizzle.config.ts",
    "db:migrate": "bun packages/data/src/migrate-cli.ts",
    "db:studio": "drizzle-kit studio --config packages/data/drizzle.config.ts",
    "lab": "bun scripts/crash-lab.ts",
    "test:lab": "bun scripts/crash-lab.ts --twice",
    "aliases": "node scripts/aliases.mjs",
    "aliases:check": "node scripts/aliases.mjs --check"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@colyseus/schema": "^5.0.8",
    "@colyseus/sdk": "^0.18.2",
    "@crash-velocity/battle": "workspace:*",
    "@crash-velocity/core": "workspace:*",
    "@crash-velocity/data": "workspace:*",
    "@crash-velocity/engine": "workspace:*",
    "@crash-velocity/game": "workspace:*",
    "@crash-velocity/net": "workspace:*",
    "@crash-velocity/physics": "workspace:*",
    "@crash-velocity/race": "workspace:*",
    "@crash-velocity/state": "workspace:*",
    "@crash-velocity/ui": "workspace:*",
    "@dimforge/rapier3d-deterministic-compat": "0.19.2",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.11",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "threejs-scene": "^0.6.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tuomashatakka/eslint-config": "^4.0.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "playwright": "^1.62.0",
    "typescript": "^6",
    "vitest": "^4.1.10"
  }
}
