{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 9002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src packages scripts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/server",
    "test": "vitest run && bun test packages/server",
    "test:physics": "node test/vehicle-physics.mjs",
    "dev:cli": "node scripts/dev-cli.mjs",
    "dev:probe": "node scripts/dev-cli.mjs probe",
    "dev:scenario": "node scripts/dev-cli.mjs scenario",
    "dev:shot": "node scripts/dev-cli.mjs shot",
    "dev:console": "node scripts/dev-cli.mjs console",
    "dev:eval": "node scripts/dev-cli.mjs eval",
    "dev:server": "bun --watch packages/server/src/index.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:replay": "bun packages/server/src/dev/replay-cli.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "next": "16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "threejs-scene": "^0.3.0",
    "zod": "^4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tuomashatakka/eslint-config": "^4.0.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "eslint": "^10.8.0",
    "playwright": "^1.62.0",
    "typescript": "^6",
    "vitest": "^4.1.10"
  }
}
