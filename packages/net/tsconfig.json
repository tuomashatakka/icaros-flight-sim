{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // A leaf, and the emptiness is the enforcement: with no `paths` an `@/…` or
    // `Δ…` import in here is a build error rather than a thing someone notices
    // once the server tries to boot. Same shape as packages/physics.
    "noEmit": true,
    "types":  [],
    "paths":  {}
  },
  "include": [ "src/**/*.ts", "test/**/*.ts" ],
  "exclude": [ "node_modules" ]
}
