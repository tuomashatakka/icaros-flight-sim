{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // No `paths` any more. Every workspace package publishes an `exports` map,
    // so `@crash-velocity/race/room` resolves through node_modules for bun,
    // node AND typescript alike — which is what the old baseUrl + Δ* aliases
    // were working around. The server no longer reaches into `src/` at all:
    // the simulations it drives moved into packages beside it.
    "plugins":           [],
    "types":             [ "bun" ],
    "noEmit":            true,
    "resolveJsonModule": true,
    "paths":             {}
  },
  "include": [ "src/**/*.ts", "test/**/*.ts" ],
  "exclude": [ "node_modules" ]
}
