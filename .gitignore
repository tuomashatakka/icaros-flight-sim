# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
# Workspaces get their own hoisted installs; the root rule is anchored and
# would not catch them.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*
# ...except the documented template, which carries no secrets and is the only
# record of what the server reads.
!.env.example

# firebase
firebase-debug.log
firestore-debug.log
# playwright-mcp scratch output
.playwright-mcp/

# dev-cli output (screenshots, traces)
/dev-out/

# Claude Code: share skills, keep personal permissions local
.claude/settings.local.json

# Battle server sqlite and crash-lab trace dumps. Both are generated; the traces
# are reproducible from `bun run lab --dump` and run to megabytes apiece.
# Anchored: an unanchored `data/` matches a directory of that name at ANY depth,
# which silently swallowed `packages/data/`.
/data/
