# Copy to `.env.local` (client) and/or export before `bun run dev:server`.
# Every value here has a working localhost default — nothing needs setting to
# play locally.

# ---------------------------------------------------------------- client

# Where the browser looks for the battle server. Defaults to the page's own
# hostname on port 9003, which is what `bun run dev:all` serves, so this only
# matters once the client is deployed somewhere the server is not.
# Use wss:// when the client is served over https, or the browser blocks the
# socket as mixed content.
# NEXT_PUBLIC_BATTLE_SERVER_URL=ws://localhost:9003

# ---------------------------------------------------------------- server

# HOST=0.0.0.0
# PORT=9003

# Simulation and broadcast rates. TICK_HZ must stay at 60: it is the same
# constant as the client's STEP, rapier's world.timestep and the dt that
# vehicleConfig is tuned against, so changing it retunes every ship AND breaks
# client prediction. SNAPSHOT_HZ must divide it evenly.
# TICK_HZ=60
# SNAPSHOT_HZ=30

# MAX_PLAYERS=16

# Seconds a disconnected player's ship is held before it is removed, so someone
# who drops mid-fight comes back to it rather than to a respawn.
# RECONNECT_GRACE_SEC=15

# Accounts and match history. Empty means in-memory: a throwaway LAN session
# should not leave a database file behind.
# DB_PATH=./data/battle.sqlite

# Comma-separated. Empty allows any origin, which is what local and LAN play
# want; set it for a public deployment. Browsers do not apply CORS to
# WebSockets, so this is the only thing gating who may open one.
# ORIGIN_ALLOWLIST=https://your-client.example

# Enables the `dev` message family behind window.__devBattle (place, face,
# status). Off in production; dev-cli sets it when it starts a server itself.
# DEV_COMMANDS=0
