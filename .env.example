# Copy to `.env.local` (client) and/or export before `bun run dev:server`.
# Every value here has a working localhost default — nothing needs setting to
# play locally. Signing in is the one exception, and it is called out below.

# ---------------------------------------------------------------- client

# Where the browser looks for the battle server. Defaults to the page's own
# hostname on port 9003, which is what `bun run dev:all` serves, so this only
# matters once the client is deployed somewhere the server is not.
# Use wss:// when the client is served over https, or the browser blocks the
# socket as mixed content.
# NEXT_PUBLIC_BATTLE_SERVER_URL=ws://localhost:9003

# ---------------------------------------------------------------- server

# HOST=0.0.0.0
# PORT=9003

# Simulation and broadcast rates. TICK_HZ must stay at 60: it is the same
# constant as the client's STEP, rapier's world.timestep and the dt that
# vehicleConfig is tuned against, so changing it retunes every ship AND breaks
# client prediction. SNAPSHOT_HZ must divide it evenly.
# TICK_HZ=60
# SNAPSHOT_HZ=30

# MAX_PLAYERS=16

# Seconds a disconnected player's ship is held before it is removed, so someone
# who drops mid-fight comes back to it rather than to a respawn.
# RECONNECT_GRACE_SEC=15


# Comma-separated, and matched exactly. Empty allows any origin, which is what
# local and LAN play want. Browsers do not apply CORS to WebSockets, so this is
# the only thing gating who may open one.
#
# Careful on Vercel: every preview deployment gets its own hostname, so listing
# only the production origin locks every preview out of the lobby socket. List
# the preview origins too, or leave it empty.
# ORIGIN_ALLOWLIST=https://your-client.example

# Enables the `dev` message family behind window.__devBattle (place, face,
# status). Off in production; dev-cli sets it when it starts a server itself.
# DEV_COMMANDS=0

# ------------------------------------------------- database (BOTH halves)

# Read by the Next app AND the battle server, and they must resolve the SAME
# database. Next mints session tokens; the battle server reads them to tell a
# registered pilot from a guest. Point them at different stores and every
# sign-in still succeeds while every lobby connection still lands as a guest —
# a failure with no error in it anywhere.

# Neon Postgres, pooled. On Vercel this is injected by the Neon marketplace
# integration; nothing to set there. Copy the same value to wherever the battle
# server runs. Its presence is what makes `neon` the driver.
# DATABASE_URL=postgres://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct connection, no PgBouncer. Only `bun run db:push` uses it — DDL takes
# locks that transaction pooling is the wrong shape for. Also injected by the
# Vercel integration.
# DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# neon | sqlite | memory. Unset means: `neon` when DATABASE_URL is set, and
# otherwise a local fallback — sqlite under Bun, memory under node. Set it
# explicitly to override, e.g. STORE_DRIVER=sqlite to develop with no network.
#
# `sqlite` is Bun-only, so it is the battle server's fallback and never the Next
# app's: `next dev` runs on node, which cannot load `bun:sqlite`. That is why
# signing in locally needs a DATABASE_URL even though playing does not.
# STORE_DRIVER=neon

# Where STORE_DRIVER=sqlite keeps its file.
# DB_PATH=./data/battle.sqlite

# Apply the Postgres schema at battle-server boot. Off by default, and never
# something to enable on Vercel: those are many uncoordinated lambdas, and
# concurrent CREATE INDEX on one table is a way to deadlock rather than to
# bootstrap. `bun run db:push` is the normal route.
# STORE_MIGRATE=0
